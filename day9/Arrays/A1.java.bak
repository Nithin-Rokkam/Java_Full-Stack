import java.util.*;
class A1 
{
	public static void main(String[] args) 
	{
		Scanner sc =new Scanner(System.in);
		//1st method to print
		int arr[] = {1,2,3,4,5};
		for(int i=0;i<arr.length;i++){
			System.out.println(arr[i]+" ");
		}
		
		//2nd method to print
		System.out.println(Arrays.toString(arr));
	}
}

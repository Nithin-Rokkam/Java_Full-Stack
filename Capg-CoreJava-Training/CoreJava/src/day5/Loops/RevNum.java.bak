import java.util.*;
class RevNum 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter the number: ");
		int num=sc.nextInt();
		int res=0;
		String Sres="";
		while(num>0){
			int temp= num % 10;
			Sres = Sres+temp;
			//res=res*10+temp;
			num/=10;
		}
		System.out.println("Res :"+ Integer.parseInt(Sres));
	}
}

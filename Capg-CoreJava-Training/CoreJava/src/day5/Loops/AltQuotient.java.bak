import java.util.*;
class AltQuotient 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter the dividend: ");
		int m=sc.nextInt();
		System.out.print("Enter the divisor: ");
		int n=sc.nextInt();
		int temp=0;
		int count=0;
		while(m>=temp){
			temp+=n;
			count++;
		}
		System.out.println("The Quotient of "+m+" & "+n+" = "+(count-1));
	}
}

import java.util.*;
class  ProdEvenOdd
{
	public static void main(String[] args) 
	{
		Scanner sc =new Scanner(System.in);
		System.out.print("Enter M val: ");
		int M=sc.nextInt();
		int resEven=0;
		int resOdd=0;
		System.out.print("Enter N val: ");
		int N=sc.nextInt();
		for(int i=M;M<N;M++){
			if(M%2==0){
				resEven*=M;
			}
			if(M%2!=0){
				resOdd*=M;
			}
		}
				System.out.println("Even val res is "  +resEven);
				System.out.println("Odd val res is "  +resOdd);
	}
}

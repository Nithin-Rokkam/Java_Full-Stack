import java.util.*;
class  PrintExcept7
{
	public static void main(String[] args) 
	{
		Scanner sc =new Scanner(System.in);
		System.out.print("Enter M val: ");
		int M=sc.nextInt();
		System.out.print("Enter N val: ");
		int N=sc.nextInt();
		for(int i = M; M < N; i++){
			boolean flag=true;
			int res=i;
			while(res>0){
				int temp=res%10;
				if(temp==7){
					flag=false;
					break;
				}
				res/=10;
			}
			if(flag) System.out.println("Even val between M & N: "+i);
			
		}
	}
}

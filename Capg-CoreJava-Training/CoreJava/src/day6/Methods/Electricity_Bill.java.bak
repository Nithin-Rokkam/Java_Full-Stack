import java.util.*;
class Electricity_Bill 
{
	public static void main(String[] args) 
	{
		Scanner sc = new Scanner(System.in);
		System.out.print("Enter the type of usage(HouseHold/Commericial): ");
		String type=sc.next();
		System.out.print("Enter the PreviousMonth-units: ");
		double Prevunits=sc.nextDouble();
		System.out.print("Enter the CurrentMonth-units: ");
		double Currunits=sc.nextDouble();
		double res=transaction(Currunits,Prevunits,type);
		if(res==-1){
			System.out.println("Invalid Units");
		}else if(res==-2){
			System.out.println("Invalid Type");
		}else{
			System.out.printf("Bill Amount: %.2f",res);
		}
	}
	
	public static double transaction(double Currunits,double Prevunits,String type){
		double amount = 50;
		double units=Prevunits-Currunits;
		if(type.equals("HouseHold")){
			if(units>0){
				if(units>0 && units<100){
					amount += units*3.29;
				}else if(units>100 && units<250){
					amount= ((units-100)*5.76)+(100*3.29);
				}else{
					amount= ((units-250)*6.75)+(150*5.76)+(100*3.29);
				}
			}else{
				return -1;
			}
		}else if(type.equals("Commericial")){
			if(units>0){
				if(units>0 && units<200){
					amount = units*4;
				}else if(units>200 && units<500){
					amount= ((units-200)*6)+(200*4);
				}else if(units>500 && units<1000){
					amount= ((units-500)*7.75)+(300*6)+(200*4) ;
				}else{
					amount= ((units-1000)*9)+(500*7.75)+(300*6)+(200*4);
				}
			}else{
				return -1;
			}
		}else{
			return -2;
		}
		return amount;
	}
}
